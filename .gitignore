# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

/.idea
/.claude/settings.local.json
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode/*
!/.vscode/extensions.json
/coverage
/dist
/node_modules
packages/*/node_modules
packages/*/dist
/.pnpm-store
/platforms
/plugins
/www

resources/android/**/*

# Generated project files
/src/i18n/languages.json

# Cypress screenshots and video recordings
/src/tests/e2e/screenshots
/src/tests/e2e/screenshots/**/*
/src/tests/e2e/videos
/src/tests/e2e/videos/**/*

android/.idea

# Localizer input file
/scripts/localizer/input.json

# Release pipeline temp output
/release-artifacts
