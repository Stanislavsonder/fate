{
	"name": "@fate-app/mod-build",
	"version": "2.0.0",
	"description": "Vite build preset + dev-mode server for authoring Assistant for Fate mods — externalizes host-shared libraries against window.FateSDK, inlines CSS, and enforces bundle size limits.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Stanislavsonder/fate.git",
		"directory": "packages/mod-build"
	},
	"type": "module",
	"types": "./src/index.ts",
	"bin": {
		"fate-mod-build": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./testing": {
			"types": "./src/testing.ts",
			"import": "./src/testing.ts"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			},
			"./testing": {
				"types": "./dist/testing.d.ts",
				"import": "./dist/testing.js"
			}
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "npm run build",
		"generate-sdk-exports": "node --experimental-transform-types scripts/generateSdkExports.ts"
	},
	"dependencies": {
		"@fate-app/mod-types": "workspace:^2.0.0",
		"vite-plugin-css-injected-by-js": "^3.5.2"
	},
	"devDependencies": {
		"@types/jsdom": "^21.1.0",
		"cannon-es": "^0.20.0",
		"es-module-lexer": "^2.3.1",
		"jsdom": "^29.1.1",
		"three": "^0.185.0"
	},
	"peerDependencies": {
		"@vitejs/plugin-vue": "^6.0.0",
		"@vue/test-utils": "^2.4.0",
		"cannon-es": "^0.20.0",
		"jsdom": "^25.0.0 || ^26.0.0 || ^27.0.0 || ^28.0.0 || ^29.0.0",
		"three": "^0.185.0",
		"vite": "^8.0.0",
		"vue": "^3.5.0"
	},
	"peerDependenciesMeta": {
		"@vue/test-utils": {
			"optional": true
		},
		"cannon-es": {
			"optional": true
		},
		"jsdom": {
			"optional": true
		},
		"three": {
			"optional": true
		}
	}
}
