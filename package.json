{
	"name": "fate",
	"private": true,
	"version": "1.5.0",
	"repository": {
		"url": "https://github.com/Stanislavsonder/fate.git"
	},
	"engines": {
		"node": ">=24.18.0"
	},
	"author": {
		"name": "Stanislav Sonder",
		"email": "stanislavsonder@gmail.com"
	},
	"type": "module",
	"lint-staged": {
		"*.{js,ts,mts,vue,json}": [
			"eslint .",
			"prettier --write"
		]
	},
	"packageManager": "pnpm@11.17.0",
	"scripts": {
		"dev": "pnpm compile-translation && vite --host",
		"translate": "node ./scripts/localizer/index.ts",
		"build:android": "pnpm build && npx cap sync android && npx cap open android",
		"build:android:ci": "pnpm build && npx cap sync android",
		"build:ios": "pnpm build && npx cap sync ios && npx cap open ios",
		"build:ios:ci": "pnpm build && npx cap sync ios",
		"build": "pnpm compile-translation && vue-tsc && vite build",
		"preview": "vite preview",
		"test:e2e": "cypress run",
		"test:unit": "vitest",
		"postinstall": "cypress install",
		"lint": "eslint . --fix",
		"format": "prettier --write .",
		"test": "pnpm test:unit && pnpm test:e2e",
		"cypress:open": "cypress open",
		"prepare": "husky",
		"version-bump": "node ./scripts/version-bump/index.ts",
		"version-bump:patch": "pnpm version-bump --patch",
		"version-bump:minor": "pnpm version-bump --minor",
		"version-bump:major": "pnpm version-bump --major",
		"check-version-bump": "node ./scripts/check-version-bump/index.ts",
		"compile-translation": "node ./scripts/translation-compiler/index.ts",
		"module:generate": "node ./scripts/module-generator/index.ts",
		"release-notes": "node ./scripts/release-notes/index.ts",
		"submit-appstore": "node ./scripts/release/submit-appstore.ts"
	},
	"dependencies": {
		"@capacitor/android": "8.4.2",
		"@capacitor/app": "8.1.1",
		"@capacitor/core": "8.4.2",
		"@capacitor/dialog": "8.0.1",
		"@capacitor/filesystem": "8.1.2",
		"@capacitor/haptics": "8.0.2",
		"@capacitor/ios": "8.4.2",
		"@capacitor/keyboard": "8.0.5",
		"@capacitor/motion": "8.0.1",
		"@capacitor/share": "8.0.1",
		"@capacitor/status-bar": "8.0.3",
		"@ionic/pwa-elements": "3.4.0",
		"@ionic/vue": "8.8.15",
		"@ionic/vue-router": "8.8.15",
		"@vueuse/core": "14.3.0",
		"cannon-es": "0.20.0",
		"cannon-es-debugger": "1.0.0",
		"dexie": "4.4.4",
		"ionicons": "8.0.13",
		"lodash": "4.18.1",
		"markdown-it": "14.3.0",
		"pinia": "4.0.2",
		"three": "0.185.1",
		"vue": "3.5.40",
		"vue-i18n": "11.4.7",
		"vue-router": "5.2.0"
	},
	"devDependencies": {
		"@capacitor/cli": "8.4.2",
		"@commitlint/config-conventional": "21.2.0",
		"@commitlint/format": "21.2.0",
		"@commitlint/types": "21.2.0",
		"@eslint/js": "10.0.1",
		"@tailwindcss/postcss": "4.3.3",
		"@tailwindcss/vite": "4.3.3",
		"@types/cannon": "0.1.13",
		"@types/lodash": "4.17.24",
		"@types/markdown-it": "14.1.2",
		"@types/semver": "7.7.1",
		"@types/three": "0.185.1",
		"@typescript-eslint/eslint-plugin": "8.65.0",
		"@typescript-eslint/parser": "8.65.0",
		"@vitejs/plugin-vue": "6.0.8",
		"@vue/eslint-config-typescript": "14.9.0",
		"@vue/test-utils": "2.4.11",
		"commitlint": "21.2.1",
		"conventional-changelog-atom": "5.1.0",
		"cypress": "15.19.0",
		"cypress-file-upload": "5.0.8",
		"eslint": "10.7.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-vue": "10.10.0",
		"globals": "17.7.0",
		"husky": "9.1.7",
		"jsdom": "29.1.1",
		"lint-staged": "17.2.0",
		"prettier": "3.9.6",
		"prettier-plugin-sort-imports": "1.8.11",
		"prettier-plugin-sort-json": "4.2.0",
		"prettier-plugin-tailwindcss": "0.8.1",
		"semver": "7.8.5",
		"tailwindcss": "4.3.3",
		"terser": "5.49.0",
		"ts-node": "10.9.2",
		"typescript": "6.0.3",
		"typescript-eslint": "8.65.0",
		"vite": "8.1.5",
		"vite-plugin-pwa": "1.3.0",
		"vitest": "4.1.10",
		"vue-tsc": "3.3.8"
	},
	"description": "Assistant for Fate - character sheets, dice and modules for the Fate RPG system."
}
